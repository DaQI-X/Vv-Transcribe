{
  "name": "vv-transcribe",
  "productName": "Vv Transcribe",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "author": "SevenQi",
  "license": "MIT",
  "description": "A simple transcribe app",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:asr": "cd python-asr && source venv/bin/activate && pyinstaller vv-asr-server.spec --clean --noconfirm",
    "build:electron": "tsc -b && vite build && electron-builder",
    "build:all": "pnpm build:asr && pnpm build:electron",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@tanstack/react-query": "^5.101.0",
    "@xenova/transformers": "^2.17.2",
    "antd": "^6.4.4",
    "fluent-ffmpeg": "^2.1.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.79.0",
    "react-router": "7.17.0",
    "react-router-dom": "7.17.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^44.4.3",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "build": {
    "appId": "com.vv.transcribe",
    "productName": "Vv Transcribe",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "src/assets/mac/logo_1024.png",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "src/assets/win/logo_256.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "src/assets/linux/logo_512.png"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/resources/**/*"
    ],
    "extraResources": [
      {
        "from": "electron/resources",
        "to": "resources"
      },
      {
        "from": "python-asr/dist",
        "to": "python-asr",
        "filter": ["vv-asr-server*"]
      }
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@ffmpeg-installer/darwin-arm64",
      "@ffmpeg-installer/linux-arm",
      "@ffmpeg-installer/linux-ia32",
      "@ffmpeg-installer/linux-x64",
      "@ffmpeg-installer/win32-ia32",
      "@ffmpeg-installer/win32-x64",
      "electron"
    ]
  }
}
